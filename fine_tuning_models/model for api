response = client.chat.completions.create(
    model="deepseek-v4-flash-vision-exp",
    messages=[
        {"role": "system", "content": "Ты — CV-разметчик. Отвечай ТОЛЬКО строками YOLO-разметки. Без пояснений."},
        {"role": "user", "content": [
            {"type": "text", "text": "Классы: 0=1...12=sigma. Формат: class_id x y w h. Разметь изображение."},
            {"type": "image_url", "image_url": {"url": "data:image/jpeg;base64,..."}}
        ]}
    ],
